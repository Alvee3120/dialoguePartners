# --- Public assets origin (per environment) --------------------------------
# The data stores object *keys* (e.g. "climet.jpg"); this is the origin they
# resolve against. Set it to the dev bucket here and to the production bucket
# (or custom domain) in production — the keys never change.
#
#   dev  → https://pub-c08eb6417f1b48ec8b568ba26a747fbb.r2.dev
#   prod → https://pub-<prod-hash>.r2.dev   (or https://assets.dialoguepartners.com)
NEXT_PUBLIC_R2_BASE_URL=

# --- Database (Postgres on the VPS) ---------------------------------------
# Example: postgres://dialogue:change-me@localhost:5432/dialoguepartners
DATABASE_URL=

# --- Cloudflare R2 (S3-compatible) — private bucket for CV uploads --------
# This is what the running app writes CVs to, for whichever environment it is.
# Endpoint is derived from the account id:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dialogue-partners-cvs

# --- Asset sync (scripts/sync-assets.ts) ----------------------------------
# Credentials for both accounts' *public assets* buckets, so objects can be
# copied dev → prod without re-uploading. Tokens need Object Read & Write
# (including List) on the respective bucket.
R2_DEV_ACCOUNT_ID=
R2_DEV_ACCESS_KEY_ID=
R2_DEV_SECRET_ACCESS_KEY=
R2_DEV_BUCKET=
R2_PROD_ACCOUNT_ID=
R2_PROD_ACCESS_KEY_ID=
R2_PROD_SECRET_ACCESS_KEY=
R2_PROD_BUCKET=

# --- One-time admin seed (scripts/seed-admin.ts) --------------------------
SEED_ADMIN_EMAIL=admin@dialoguepartners.com
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_ADMIN_NAME=Administrator
